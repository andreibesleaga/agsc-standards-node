{"@context":"https://standards.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://standards.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.1.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://standards.agenticsystemcore.com/concepts/json-canonicalization/","@type":"Concept","created":"2026-11-18T00:00:00Z","definition":{"@language":"en","@value":"One fixed way to write JSON, so that equal data gives equal bytes before hashing or signing."},"inScheme":"https://standards.agenticsystemcore.com/","kind":"explainer","model":"Claude (Anthropic)","operator":"human:andreibesleaga","origin":"ai-assisted","prefLabel":{"@language":"en","@value":"JSON canonicalization (RFC 8785)"},"related":"https://standards.agenticsystemcore.com/concepts/rdf-dataset-canonicalization/","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":"https://standards.agenticsystemcore.com/concepts/json-canonicalization/#source-1","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://standards.agenticsystemcore.com/concepts/json-canonicalization/#source-1","@type":"Source","creator":"Rundgren, A.; Jordan, B.; Erdtman, S.","date":"2020","dcterms:source":"https://www.rfc-editor.org/rfc/rfc8785","grade":"primary","title":"JSON Canonicalization Scheme (JCS)","verifiedOn":"2026-11-18T00:00:00Z"}]}
