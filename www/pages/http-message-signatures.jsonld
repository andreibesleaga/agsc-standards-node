{"@context":"https://standards.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://standards.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.1.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://standards.agenticsystemcore.com/concepts/http-message-signatures/","@type":"Concept","created":"2026-11-18T00:00:00Z","definition":{"@language":"en","@value":"A way to sign parts of an HTTP message, so a receiver can check who sent it and that it was not changed."},"inScheme":"https://standards.agenticsystemcore.com/","isRequiredBy":"https://standards.agenticsystemcore.com/concepts/web-bot-auth/","kind":"explainer","model":"Claude (Anthropic)","operator":"human:andreibesleaga","origin":"ai-assisted","prefLabel":{"@language":"en","@value":"HTTP message signatures (RFC 9421)"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":"https://standards.agenticsystemcore.com/concepts/http-message-signatures/#source-1","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0","uses":"https://standards.agenticsystemcore.com/concepts/digest-fields/"},{"@id":"https://standards.agenticsystemcore.com/concepts/http-message-signatures/#source-1","@type":"Source","creator":"Backman, A.; Richer, J.; Sporny, M.","date":"2024","dcterms:source":"https://www.rfc-editor.org/rfc/rfc9421","grade":"primary","title":"HTTP Message Signatures","verifiedOn":"2026-11-18T00:00:00Z"}]}
