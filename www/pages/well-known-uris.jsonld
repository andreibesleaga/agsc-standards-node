{"@context":"https://standards.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://standards.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.1.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://standards.agenticsystemcore.com/concepts/well-known-uris/","@type":"Concept","created":"2026-11-18T00:00:00Z","definition":{"@language":"en","@value":"A reserved path on every site, /.well-known/, where a site publishes files about itself at a fixed place."},"inScheme":"https://standards.agenticsystemcore.com/","isRequiredBy":"https://standards.agenticsystemcore.com/concepts/api-catalog/","kind":"explainer","model":"Claude (Anthropic)","operator":"human:andreibesleaga","origin":"ai-assisted","prefLabel":{"@language":"en","@value":"Well-known addresses (RFC 8615)"},"related":"https://standards.agenticsystemcore.com/concepts/llms-txt/","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":"https://standards.agenticsystemcore.com/concepts/well-known-uris/#source-1","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0","usedBy":["https://standards.agenticsystemcore.com/concepts/security-txt/","https://standards.agenticsystemcore.com/concepts/tdm-reservation-protocol/"]},{"@id":"https://standards.agenticsystemcore.com/concepts/well-known-uris/#source-1","@type":"Source","creator":"Nottingham, M.","date":"2019","dcterms:source":"https://www.rfc-editor.org/rfc/rfc8615","grade":"primary","title":"Well-Known Uniform Resource Identifiers (URIs)","verifiedOn":"2026-11-18T00:00:00Z"}]}
